// CFG builder test: an if inside a while inside an if (Week 9's take-home shape)
int main(){
    int n,i,evens,odds;
    n = 6;
    evens = 0;
    odds = 0;
    if (n > 0) {
        i = 1;
        while (i <= n) {
            if (i - (i / 2) * 2 == 0)
                evens = evens + 1;
            else
                odds = odds + 1;
            i = i + 1;
        }
    }
    print evens;
    print odds;
}
