// recursion: every active call has its own activation record
int fact(int n){
    if (n <= 1)
        return 1;
    return n * fact(n - 1);
}
int fib(int n){
    if (n < 2)
        return n;
    return fib(n - 1) + fib(n - 2);   // fib(n-1)'s result must survive the fib(n-2) call
}
int main(){
    print fact(5);
    print fib(10);
}
